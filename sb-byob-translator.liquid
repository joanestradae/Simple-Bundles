<script>
(function () {
  const translationConfigs = {
    de: [
      {
        selector: '.byob-cta',
        replacements: [
          {
            originalText: 'Select',
            translatedText: 'Auswählen'
          },
          {
            originalText: 'Added',
            translatedText: 'Hinzugefügt'
          },
          {
            originalText: 'Add',
            translatedText: 'Hinzufügen'
          },
          {
            originalText: 'Out of stock',
            translatedText: 'Nicht auf Lager'
          },
          {
            originalText: 'Max quantity added',
            translatedText: 'Max hinzugefügte Menge'
          }
        ]
      },
      {
        selector: '.byob-resource__remove-text',
        replacements: [
          {
            originalText: 'Remove',
            translatedText: 'Entfernen'
          }
        ]
      },
      {
        selector: '.byob-resource__title',
        replacements: [
          {
            originalText: 'Add a product',
            translatedText: 'Produkt hinzufügen'
          }
        ]
      },
      {
        selector: '.byob-mini-cart__checkout',
        replacements: [
          {
            textPattern: /Add (\d+) more/g,
            translatedText: 'Noch $1 hinzufügen'
          },
          {
            originalText: 'Added to cart',
            translatedText: 'Zum Warenkorb hinzugefügt'
          },
          {
            originalText: 'Add bundle to cart',
            translatedText: 'Bundle zum Warenkorb hinzufügen'
          }
        ]
      },
      {
        selector: '.byob-options-modal__details-link',
        replacements: [
          {
            originalText: 'See full details',
            translatedText: 'Alle Details anzeigen'
          }
        ]
      }
    ]
  };

  const storefrontLanguageCode = (
    document.documentElement.lang ||
    window.Shopify?.locale ||
    ''
  ).toLowerCase().split('-')[0];

  const translations =
    translationConfigs[storefrontLanguageCode];

  if (!translations) return;

  function initializeTranslations(byobWrapper) {
    function translateElement(element, entry) {
      const walker = document.createTreeWalker(
        element,
        NodeFilter.SHOW_TEXT
      );

      let textNode;

      while ((textNode = walker.nextNode())) {
        const sourceText = textNode.nodeValue;

        for (const replacement of entry.replacements) {
          if (replacement.textPattern) {
            const translatedText = sourceText.replace(
              replacement.textPattern,
              replacement.translatedText
            );

            if (translatedText !== sourceText) {
              textNode.nodeValue = translatedText;
              break;
            }
          } else if (sourceText === replacement.originalText) {
            textNode.nodeValue = replacement.translatedText;
            break;
          }
        }
      }
    }

    function applyTranslations() {
      translations.forEach((entry) => {
        byobWrapper
          .querySelectorAll(entry.selector)
          .forEach((element) => {
            translateElement(element, entry);
          });
      });
    }

    applyTranslations();

     const translationObserver = new MutationObserver((mutationsList) => {
      mutationsList.forEach((mutation) => {
        // We only care about new nodes being added
        if (mutation.type === 'childList') {
          mutation.addedNodes.forEach((node) => {
            // Only process Element nodes (skip raw text or comment nodes)
            if (node.nodeType === Node.ELEMENT_NODE) {
              translations.forEach((entry) => {
                
                // 1. Check if the newly added node ITSELF matches the selector
                if (node.matches(entry.selector)) {
                  translateElement(node, entry);
                }
                
                // 2. Check if any CHILDREN of the new node match
                node.querySelectorAll(entry.selector).forEach((element) => {
                  translateElement(element, entry);
                });
                
              });
            }
          });
        }
      });
    });

    translationObserver.observe(byobWrapper, {
      childList: true,
      subtree: true,
    });
  }

  function findAndInitialize() {
    const byobWrapper = document.querySelector(
      '#byob-app-embed-wrapper'
    );

    if (!byobWrapper) return false;

    initializeTranslations(byobWrapper);
    return true;
  }

  function observeForEmbed() {
    const embedObserver = new MutationObserver(() => {
      if (!findAndInitialize()) return;

      embedObserver.disconnect();
      clearTimeout(observerTimeout);
    });

    const observerTimeout = setTimeout(() => {
      embedObserver.disconnect();
    }, 5000);

    embedObserver.observe(document.documentElement, {
      childList: true,
      subtree: true
    });
  }

  // Initialize immediately if the embed is already available.
  if (findAndInitialize()) return;

  // If the DOM is still loading, wait until it has been parsed
  // before checking again and starting the observer if needed.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      if (findAndInitialize()) return;

      observeForEmbed();
    }, { once: true });

    return;
  }

  // The DOM is already ready, so start watching for the embed.
  observeForEmbed();
})();
</script>
